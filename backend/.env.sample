# Runtime environment: local | dev | prod
ENVIRONMENT=prod

# Local / development PostgreSQL database
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME

# Cloud SQL settings used when ENVIRONMENT=prod
DB_USER=
DB_PASS=
DB_NAME=
INSTANCE_CONNECTION_NAME=

# Authentication
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:5173
